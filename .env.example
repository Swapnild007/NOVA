# NOVA direct-provider router
# Keys are server-side only. Never expose them as NEXT_PUBLIC_* variables.

# Primary free/direct providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Cerebras direct OpenAI-compatible API
CEREBRAS_API_KEY=
CEREBRAS_MODEL=


NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b

# Z.AI
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=

# Alibaba Model Studio / Qwen
# Use the endpoint and key from the same Model Studio region/workspace.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=

# Optional self-hosted/local FreeLLMAPI router
# Example: http://localhost:3001/v1 when NOVA and FreeLLMAPI run on the same network.
FREELLMAPI_API_KEY=
FREELLMAPI_BASE_URL=
FREELLMAPI_MODEL=

# Router order. The first configured healthy provider wins.
NOVA_PROVIDER_ORDER=gemini,groq,cerebras,mistral,nvidia,zai,qwen,freellmapi,gateway
NOVA_PROVIDER_TIMEOUT_MS=45000

# Optional external gateway fallback.
NOVA_GATEWAY_URL=
NOVA_GATEWAY_API_KEY=
NOVA_GATEWAY_MODEL=
NOVA_GATEWAY_MODEL_GENERAL=
NOVA_GATEWAY_MODEL_RESEARCH=
NOVA_GATEWAY_MODEL_CREATE=
NOVA_GATEWAY_MODEL_ANALYZE=
NOVA_GATEWAY_MODEL_BUILD=
NOVA_GATEWAY_MODEL_PLAN=
NOVA_GATEWAY_MODEL_ACT=
NOVA_GATEWAY_FALLBACK_MODELS=
NOVA_GATEWAY_TIMEOUT_MS=45000
NOVA_GATEWAY_ROUTE=auto
NOVA_GATEWAY_ZDR=true
