# NOVA Intelligence Gateway
# Point this at a deployed OmniRoute instance, e.g. https://your-gateway.example.com/v1
NOVA_GATEWAY_URL=
NOVA_GATEWAY_API_KEY=
NOVA_GATEWAY_MODEL=auto
NOVA_GATEWAY_MODEL_BUILD=auto/coding
NOVA_GATEWAY_MODEL_RESEARCH=auto/smart
NOVA_GATEWAY_MODEL_ANALYZE=auto/smart
NOVA_GATEWAY_MODEL_PLAN=auto/smart
NOVA_GATEWAY_TIMEOUT_MS=25000

# Direct emergency fallback providers.
# These are used only when OmniRoute is unavailable.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODELS=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODELS=
